# Normaliza line endings para LF em todos os arquivos de texto
* text=auto eol=lf

# Arquivos que devem ser sempre LF
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.env*  text eol=lf
*.sh    text eol=lf

# Binários — sem conversão
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
