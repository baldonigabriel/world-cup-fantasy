{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "lib": ["ES2022"],
    "target": "ES2022",
    "moduleResolution": "bundler"
  },
  "exclude": ["node_modules", "dist", "build", ".next", "coverage"]
}
